# Matrix: every graph falls like a stream of code, from Dark Green through
# Islamic Green and Malachite to the near white of the leading glyph.

theme[main_bg]="#0D0208"
theme[main_fg]="#00FF41"
theme[title]="#DCFFDB"
theme[hi_fg]="#DCFFDB"
theme[selected_bg]="#003B00"
